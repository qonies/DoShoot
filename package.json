{
  "name": "DoShoot",
  "version": "0.3.1",
  "private": true,
  "description": "DoShoot Web — 浏览器多人在线俯视角射击游戏",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:client": "corepack pnpm -F @DoShoot/client dev",
    "dev:server": "corepack pnpm -F @DoShoot/server dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "smoke:server": "corepack pnpm -F @DoShoot/server smoke",
    "smoke:net": "corepack pnpm -F @DoShoot/server exec tsx ../../scripts/net-smoke.ts",
    "unit": "corepack pnpm -F @DoShoot/server exec tsx ../../scripts/unit-check.ts",
    "check:i18n": "corepack pnpm -F @DoShoot/server exec tsx ../../scripts/i18n-check.ts",
    "loadtest": "corepack pnpm -F @DoShoot/server exec tsx ../../scripts/load-test.ts"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4"
  }
}
